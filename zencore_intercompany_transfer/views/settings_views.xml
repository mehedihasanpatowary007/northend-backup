<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_intercompany" model="ir.ui.view">
        <field name="name">res.config.settings.intercompany</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Inter-Company Transfer" name="intercompany_transfer" groups="stock.group_stock_manager">
                    <setting string="In-Transit Valuation Account" company_dependent="1"
                             help="Inventory valuation uses the existing product category account.">
                        <field name="in_transit_valuation_account_id" domain="[('company_ids', 'in', company_id), ('account_type', '=', 'asset_current')]" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Receiving Operation" company_dependent="1"
                             help="Choose an existing internal operation with the receiving warehouse stock location as its default destination.">
                        <field name="intercompany_receipt_type_id" domain="[('company_id', '=', company_id), ('code', '=', 'internal')]" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
