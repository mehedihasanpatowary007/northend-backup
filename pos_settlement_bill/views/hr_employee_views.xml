<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_settlement_bill_permission" model="ir.ui.view">
        <field name="name">hr.employee.settlement.bill.permission</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']/field[@name='pin']" position="after">
                <field name="pos_settlement_bill_allowed" groups="hr.group_hr_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
