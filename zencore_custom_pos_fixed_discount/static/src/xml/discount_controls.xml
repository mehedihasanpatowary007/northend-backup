<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zencore_custom_pos_fixed_discount.Keypad" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//Numpad" position="attributes">
            <attribute name="t-if">!currentOrder?.isEmpty() and (pos.getOrder()?.uiState.selected_orderline_uuid or pos.numpadMode.startsWith('global_'))</attribute>
        </xpath>
        <xpath expr="//Numpad" position="before">
            <div t-if="!currentOrder?.isEmpty() and neEditingLabel" class="ne-discount-context small px-2" aria-live="polite">
                Editing: <strong t-esc="neEditingLabel"/> · <span t-esc="neEditingValue"/>
                <div t-if="currentOrder.uiState.neDiscountHint" class="text-warning" t-esc="currentOrder.uiState.neDiscountHint"/>
            </div>
        </xpath>
        <xpath expr="//Numpad" position="after">
            <div t-if="!currentOrder?.isEmpty()" class="ne-discount-buttons" role="group" aria-label="Line and order discounts">
                <button class="btn ne-discount-line" t-att-class="pos.numpadMode === 'line_percent' ? 'btn-primary active' : 'btn-secondary'"
                    t-att-disabled="!neCanLineDiscount()" t-att-aria-pressed="pos.numpadMode === 'line_percent' ? 'true' : 'false'"
                    title="Percentage discount on the selected item" aria-label="Line percentage discount"
                    t-on-click="() => this.neDiscountMode('line_percent')">
                    <span class="ne-discount-scope">Line</span>
                    <span class="ne-discount-type">% Discount</span>
                </button>
                <button class="btn ne-discount-line" t-att-class="pos.numpadMode === 'line_fixed' ? 'btn-primary active' : 'btn-secondary'"
                    t-att-disabled="!neCanLineDiscount()" t-att-aria-pressed="pos.numpadMode === 'line_fixed' ? 'true' : 'false'"
                    title="Fixed amount discount on the selected item" aria-label="Line fixed amount discount"
                    t-on-click="() => this.neDiscountMode('line_fixed')">
                    <span class="ne-discount-scope">Line</span>
                    <span class="ne-discount-type"><t t-esc="currentOrder.currency.symbol"/> Fixed</span>
                </button>
                <button class="btn ne-discount-order" t-att-class="pos.numpadMode === 'global_percent' ? 'btn-primary active' : 'btn-secondary'"
                    t-att-disabled="!neCanOrderDiscount()" t-att-aria-pressed="pos.numpadMode === 'global_percent' ? 'true' : 'false'"
                    title="Percentage discount on the whole order" aria-label="Order percentage discount"
                    t-on-click="() => this.neDiscountMode('global_percent')">
                    <span class="ne-discount-scope">Order</span>
                    <span class="ne-discount-type">% Discount</span>
                </button>
                <button class="btn ne-discount-order" t-att-class="pos.numpadMode === 'global_fixed' ? 'btn-primary active' : 'btn-secondary'"
                    t-att-disabled="!neCanOrderDiscount()" t-att-aria-pressed="pos.numpadMode === 'global_fixed' ? 'true' : 'false'"
                    title="Fixed amount discount on the whole order" aria-label="Order fixed amount discount"
                    t-on-click="() => this.neDiscountMode('global_fixed')">
                    <span class="ne-discount-scope">Order</span>
                    <span class="ne-discount-type"><t t-esc="currentOrder.currency.symbol"/> Fixed</span>
                </button>
            </div>
        </xpath>
    </t>
    <t t-name="zencore_custom_pos_fixed_discount.OrderTotals" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]//span[hasclass('subtotal')]" position="attributes">
            <attribute name="t-esc">formatCurrency(order.neSummarySubtotal)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-summary')]//span[hasclass('tax')]" position="attributes">
            <attribute name="t-esc">formatCurrency(order.neSummaryTax)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-summary')]//span[hasclass('total')]" position="attributes">
            <attribute name="t-esc">formatCurrency(order.neSummaryGross)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <t t-if="order.neGlobalDiscountAmount">
                <div class="ne-order-discount-row d-flex justify-content-between w-100 fs-6 fw-normal">
                    <span t-esc="order.neGlobalDiscountLabel"/>
                    <span t-esc="formatCurrency(-order.neGlobalDiscountAmount)"/>
                </div>
                <div t-if="order.prices.taxDetails.has_tax_groups" class="ne-final-tax-note d-flex justify-content-between w-100 small text-muted fw-normal">
                    <span>Taxes included after discount</span>
                    <span t-esc="order.currencyAmountTaxes"/>
                </div>
                <div class="ne-grand-total d-flex justify-content-between w-100 fs-3 border-top pt-1">
                    <span>Grand Total</span>
                    <span t-esc="order.currencyDisplayPriceIncl"/>
                </div>
            </t>
        </xpath>
    </t>
    <t t-name="zencore_custom_pos_fixed_discount.Receipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="before">
            <div t-if="order.neGlobalDiscountAmount" class="ne-receipt-global-discount pt-2">
                <div class="d-flex justify-content-between"><span>Items after Line Discounts (Tax Included)</span><span t-esc="formatCurrency(order.neGrossBeforeGlobal)"/></div>
                <div class="d-flex justify-content-between"><span t-esc="order.neGlobalDiscountLabel"/><span t-esc="formatCurrency(-order.neGlobalDiscountAmount)"/></div>
            </div>
        </xpath>
    </t>
</templates>
