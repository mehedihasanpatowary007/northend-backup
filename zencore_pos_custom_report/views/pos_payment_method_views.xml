<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_mfs" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mfs</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="pos_is_mfs"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_inherit_mfs" model="ir.ui.view">
        <field name="name">pos.payment.method.list.inherit.mfs</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pos_is_mfs" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
