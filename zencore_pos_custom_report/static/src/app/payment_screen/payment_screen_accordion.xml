<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="zencore_pos_custom_report.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods')]" position="replace">
            <div class="paymentmethods zencore-payment-accordions d-flex flex-column gap-2" t-att-class="{ 'p-1 overflow-y-auto rounded-3 bg-200': ui.isSmall }">
                <t t-foreach="groupedPaymentMethods" t-as="group" t-key="group.type">
                    <div class="zencore-accordion-card card border rounded-3 overflow-hidden shadow-sm">
                        <!-- Category Header Button -->
                        <div class="zencore-accordion-header btn btn-light d-flex justify-content-between align-items-center py-3 px-3 w-100 fw-bold fs-5 text-start border-0"
                            role="button"
                            t-att-class="{ 'active bg-primary-subtle border-primary': accordionState.activeType === group.type }"
                            t-on-click="() => this.toggleAccordion(group.type)">
                            <div class="d-flex align-items-center gap-2">
                                <i t-att-class="group.iconClass" class="fa fs-4" />
                                <span class="group-title" t-esc="group.label" />
                                <span class="badge bg-secondary rounded-pill ms-1" t-esc="group.methods.length" />
                            </div>
                            <i class="fa fa-chevron-down zencore-chevron-icon"
                                t-att-class="{ 'rotate-180 text-primary': accordionState.activeType === group.type, 'text-muted': accordionState.activeType !== group.type }" />
                        </div>

                        <!-- Accordion Collapsible Body -->
                        <div class="zencore-accordion-body d-flex flex-column gap-2 p-2 bg-white border-top"
                            t-if="accordionState.activeType === group.type">
                            <t t-foreach="group.methods" t-as="paymentMethod" t-key="paymentMethod.id">
                                <div t-if="!(this.pos.cashier._role === 'minimal' and paymentMethod.type === 'pay_later')"
                                    class="button paymentmethod btn btn-secondary btn-lg lh-lg flex-fill d-flex justify-content-between align-items-center"
                                    role="button"
                                    t-att-class="{'opacity-50': this.pos.paymentTerminalInProgress and paymentMethod.use_payment_terminal}"
                                    t-on-click="() => this.addNewPaymentLine(paymentMethod)">
                                    <div class="payment-method-display d-flex align-items-center gap-2 text-wrap text-start lh-sm">
                                        <img class="payment-method-icon" t-att-src="paymentMethodImage(paymentMethod.id)" />
                                        <span class="payment-name fw-semibold" t-esc="paymentMethod.name" />
                                    </div>
                                    <span class="text-muted" t-esc="pos.getPaymentMethodFmtAmount(paymentMethod, currentOrder)"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
